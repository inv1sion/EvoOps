# Optional. EvoOps runs with a deterministic local analyzer when these are empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-flash-2026-07-15
EVOOPS_JUDGE_MODEL=qwen3.7-max-2026-06-08
EVOOPS_PROMPT_OPTIMIZER_MODEL=qwen3.7-flash-2026-07-15
EVOOPS_LLM_EVAL_ENABLED=true
# With a key, enable the bounded read-only model/tool loop. false keeps the fixed workflow.
EVOOPS_TOOL_CALLING_ENABLED=true

# Runtime settings
EVOOPS_ADDR=:8080
EVOOPS_DATA_DIR=data/runtime
EVOOPS_DEMO_DATA=data/demo/store.json
EVOOPS_HARNESS_DATA=data/harness/suite.json

# Production-style RAG. Keep "local" for deterministic/offline tests; use
# "external" after starting deployments/rag/docker-compose.yml.
EVOOPS_RAG_BACKEND=local
EVOOPS_RAG_AUTO_SEED=true
EVOOPS_RAG_POSTGRES_URL=postgres://evoops:evoops@localhost:5432/evoops?sslmode=disable
EVOOPS_RAG_REDIS_ADDR=localhost:6379
EVOOPS_RAG_REDIS_PASSWORD=
EVOOPS_RAG_REDIS_DB=0
EVOOPS_RAG_REDIS_TTL_SECONDS=900
EVOOPS_RAG_MILVUS_ADDR=localhost:19530
EVOOPS_RAG_MILVUS_TOKEN=
EVOOPS_RAG_MILVUS_DATABASE=default
EVOOPS_RAG_MILVUS_COLLECTION=evoops_knowledge_l3
EVOOPS_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVOOPS_RAG_EMBEDDING_MODEL=text-embedding-v3
EVOOPS_RAG_EMBEDDING_DIMENSIONS=1024
EVOOPS_RAG_RERANK_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
EVOOPS_RAG_RERANK_MODEL=qwen3-rerank
EVOOPS_RAG_MAX_CONTEXT_CHARS=6000
